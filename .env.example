# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# Required: free Groq API key — get one at https://console.groq.com (no card needed)
GROQ_API_KEY=gsk_...

# Optional: free Tavily key for live web search — https://app.tavily.com (1000 searches/month free)
TAVILY_API_KEY=tvly-...

# Optional overrides
HUB_HOME=./research_hub_data        # where library and state are stored
HUB_MODEL=openai/gpt-oss-120b       # model on your Groq account
HUB_DEMO=                           # set to "1" to run without any API key
HUB_USER=admin                      # username for site login (default: admin)
HUB_PASS=                           # password for site login — set this to protect your app!
